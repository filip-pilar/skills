                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "const": "inference"
                    },
                    "ref": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
