#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./scripts/check-full [--strict]

Run the fast repository check plus deeper, credential-free integration tests.

Options:
  --strict  Accepted for compatibility; does not enable opt-in browser tests.
USAGE
}

strict=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --strict) strict=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
skills_dir="$repo_root/skills"

"$script_dir/check-repo"

printf '\n== Web Traffic Inspector companion integration ==\n'
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest \
  discover -s "$skills_dir/web-traffic-inspector/tests" -p 'test_companion_integration.py'

printf '\nfull_check=passed integration_suites_run=1 strict=%s\n' "$strict"
printf 'Individual test skips are reported by unittest above; opt-in browser tests may be skipped.\n'
